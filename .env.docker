# OpenClaw Docker 部署配置

# 网关端口
OPENCLAW_GATEWAY_PORT=9999

# 网关绑定模式（固定使用 lan，方便局域网访问）
OPENCLAW_GATEWAY_BIND=lan

# 网关绑定模式
# lan: 允许局域网访问（推荐）
# loopback: 仅本地访问
OPENCLAW_GATEWAY_BIND=lan

# Control UI 允许的源（用于 lan 模式）
OPENCLAW_GATEWAY_CONTROL_UI_ALLOWED_ORIGINS=http://localhost:9999,http://127.0.0.1:9999

# 网关认证 Token（固定 Token，自动启动网关时使用）
# 使用固定的 Token，无需每次输入
OPENCLAW_GATEWAY_TOKEN=oc-authtok-a3f8c9d2e7b6f1a5c8d3e2f7a9b4c1d6e8f2a5b9c3d7e1a4f8b2c6d9e3a7f1b5c8
OPENCLAW_GATEWAY_PASSWORD=oc-authtok-a3f8c9d2e7b6f1a5c8d3e2f7a9b4c1d6e8f2a5b9c3d7e1a4f8b2c6d9e3a7f1b5c8

# 配置目录（挂载到 Docker 容器）
OPENCLAW_CONFIG_DIR=~/.openclaw

# 工作空间目录（挂载到 Docker 容器）
OPENCLAW_WORKSPACE_DIR=~/.openclaw/workspace

# Claude 相关配置（如果需要）
# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=

# 安全选项（开发环境可以设置为 true）
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=true

# Docker 镜像
OPENCLAW_IMAGE=openclaw:local
